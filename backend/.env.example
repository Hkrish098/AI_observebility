# Paste your keys here, then copy this file to .env
# cp .env.example .env

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Groq — intent routing
GROQ_API_KEY=
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

# Gemini — embeddings, tool calling, synthesis, LLM-as-judge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cohere — rerank
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

LLM_TEMPERATURE=0.2
PROMPT_VERSION=v1

COST_FLAG_THRESHOLD_USD=0.05
GROUNDEDNESS_FLAG_THRESHOLD=0.7
LATENCY_FLAG_THRESHOLD_MS=8000
